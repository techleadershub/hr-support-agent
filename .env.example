# --- LLM + embeddings ---
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...                 # only used for text-embedding-3-small (query + index build)

# --- State store (Supabase Postgres via PostgREST) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# --- App ---
HR_AGENT_ACCESS_KEY=change-me         # required in X-Access-Key header (or ?access_key=) on every /api/* call except /api/health
HR_AGENT_MODEL=claude-opus-5          # any current Claude model id
HR_AGENT_EFFORT=medium                # low | medium | high
HR_AGENT_TODAY=                       # optional YYYY-MM-DD to freeze "today" (deterministic tests); X-Today header overrides per request
HR_AGENT_MAX_ITERATIONS=8
EMBEDDING_MODEL=text-embedding-3-small
